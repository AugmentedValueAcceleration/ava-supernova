{
  "name": "ava-supernova",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI coding assistant — agentic coding for everyone",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ava/cli dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "vscode",
    "deepseek",
    "kimi",
    "glm",
    "mistral",
    "agentic",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AugmentedValueAcceleration/ava-supernova"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "rollup": ">=4.59.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
