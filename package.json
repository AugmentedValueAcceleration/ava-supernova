{
  "name": "ava-supernova",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI coding assistant — agentic coding for everyone",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ava/cli dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "vscode",
    "deepseek",
    "kimi",
    "glm",
    "mistral",
    "agentic",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stewai/ava-supernova"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
