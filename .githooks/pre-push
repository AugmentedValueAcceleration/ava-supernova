#!/bin/sh
# Pre-push typecheck gate for the VS Code extension.
#
# Two checks, different strictness:
#
#   1. HOST (packages/extension/src/**) — NARROW.
#      Only blocks on undefined-identifier class errors (TS2304, TS18004).
#      These compile cleanly under esbuild but throw at runtime. This is the
#      class of bug that shipped in v0.48.2 / v0.48.3 and cost two hotfixes.
#      Other pre-existing host errors are intentionally filtered out until
#      a dedicated host-type cleanup sprint — a strict host gate would block
#      routine pushes today.
#
#   2. WEBVIEWS (packages/extension/dashboard-ui + webview-ui) — STRICT.
#      Blocks on ANY type error. Both webviews were fully cleaned by the
#      mirror-elimination refactor, and now share a single source-of-truth
#      message-type file via path alias. The gate prevents that from drifting
#      again.
#
# Setup: runs automatically once git is told to use this hooks directory:
#     git config core.hooksPath .githooks
# Done once per clone. The repo's README lists it under contributor setup.

set -e

if [ ! -f packages/extension/package.json ]; then
  exit 0
fi

echo "[pre-push] Typecheck host (narrow: TS2304 / TS18004)..."
HOST_OUT=$(cd packages/extension && pnpm typecheck 2>&1 || true)
HOST_FAIL=$(echo "$HOST_OUT" | grep -E "error TS2304|error TS18004" || true)
if [ -n "$HOST_FAIL" ]; then
  echo ""
  echo "⛔  Push blocked: undefined identifier(s) in the extension host."
  echo "    These compile under esbuild but throw at runtime."
  echo ""
  echo "$HOST_FAIL"
  echo ""
  echo "    Fix the references or add the missing declarations, then re-push."
  echo "    Bypass in an emergency: git push --no-verify (not recommended)."
  exit 1
fi
echo "[pre-push] ✓ Host: no undefined-identifier errors."

echo "[pre-push] Typecheck webviews (strict: any TS error blocks)..."
WV_OUT=$(cd packages/extension && pnpm typecheck:webviews 2>&1 || true)
WV_FAIL=$(echo "$WV_OUT" | grep -E "error TS[0-9]+" || true)
if [ -n "$WV_FAIL" ]; then
  echo ""
  echo "⛔  Push blocked: type errors in the webview(s)."
  echo "    Webview typechecks are strict — the mirror-elimination refactor"
  echo "    cleaned them to zero and we want to keep them that way."
  echo ""
  echo "$WV_FAIL" | head -30
  COUNT=$(echo "$WV_FAIL" | wc -l | tr -d ' ')
  if [ "$COUNT" -gt 30 ]; then
    echo ""
    echo "    ... and $((COUNT - 30)) more (run 'pnpm -F ava-supernova typecheck:webviews' for the full list)."
  fi
  echo ""
  echo "    Fix the errors and re-push."
  echo "    Bypass in an emergency: git push --no-verify (not recommended)."
  exit 1
fi
echo "[pre-push] ✓ Webviews: clean."

exit 0
