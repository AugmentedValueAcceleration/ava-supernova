#!/bin/sh
# Pre-push typecheck gate for the VS Code extension.
#
# STRICT on everything — host + both webviews. Any `tsc --noEmit` error
# blocks the push. Runtime-breaking undefined-identifier bugs (v0.48.2 /
# v0.48.3 class) and any other regressions both get caught here.
#
# Prior versions of this hook filtered host errors down to TS2304 / TS18004
# only, because the host codebase had long-standing debt (~67 pre-existing
# type errors) that a strict gate would block routine pushes on. The
# mirror-elimination refactor + host cleanup sprint brought both webviews
# and the host to zero errors — this gate now keeps them there.
#
# Setup: runs automatically once git is told to use this hooks directory:
#     git config core.hooksPath .githooks
# Done once per clone. The repo's README lists it under contributor setup.

set -e

if [ ! -f packages/extension/package.json ]; then
  exit 0
fi

echo "[pre-push] Typecheck extension (host + both webviews, strict)..."
OUTPUT=$(cd packages/extension && pnpm typecheck:all 2>&1 || true)

ERRORS=$(echo "$OUTPUT" | grep -E "error TS[0-9]+" || true)
if [ -n "$ERRORS" ]; then
  echo ""
  echo "⛔  Push blocked: type errors in the extension."
  echo ""
  echo "$ERRORS" | head -30
  COUNT=$(echo "$ERRORS" | wc -l | tr -d ' ')
  if [ "$COUNT" -gt 30 ]; then
    echo ""
    echo "    ... and $((COUNT - 30)) more (run 'pnpm -F ava-supernova typecheck:all' for the full list)."
  fi
  echo ""
  echo "    Fix the errors and re-push."
  echo "    Bypass in an emergency: git push --no-verify (not recommended)."
  exit 1
fi

echo "[pre-push] ✓ Typecheck clean (host + dashboard-ui + webview-ui)."
exit 0
