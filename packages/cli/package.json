{
  "name": "@ava/cli",
  "version": "0.9.0",
  "description": "CLI interface for Ava Supernova \u00e2\u20ac\u201d interactive coding agent",
  "type": "module",
  "bin": {
    "ava": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ava/core": "workspace:*",
    "@napi-rs/keyring": "2.1.2",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "marked": "^17.0.3",
    "marked-terminal": "^7.3.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
