{
  "name": "@ava/core",
  "version": "0.1.0",
  "description": "Core engine for Ava | Supernova — agent, providers, tools, config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
