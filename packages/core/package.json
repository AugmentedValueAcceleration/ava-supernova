      "require": "./dist/health/starters.js",
      "types": "./dist/health/starters.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "publish:public": "node scripts/publish-public.mjs",
    "publish:public:dry": "node scripts/publish-public.mjs --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "docs:sync": "node docs/sync-to-web.mjs",
    "docs:check": "node docs/sync-to-web.mjs && git -C ../web diff --quiet src/lib/docs || (echo 'docs corpus desynced — run pnpm docs:sync and commit the web submodule' && exit 1)"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "marked": "^17.0.3",
    "pngjs": "^7.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "docx": ">=9.0.0",
    "exceljs": ">=4.0.0",
    "mammoth": ">=1.6.0",
    "mysql2": ">=3.0.0",
    "pdf-parse": ">=1.1.0",
    "pdfkit": ">=0.15.0",
    "pg": ">=8.0.0",
    "playwright": ">=1.40.0",
    "screenshot-desktop": ">=1.15.0"
  },
  "peerDependenciesMeta": {
    "screenshot-desktop": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "pg": {
