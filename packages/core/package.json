      "types": "./dist/creative/index.d.ts"
    },
    "./audit": {
      "import": "./dist/audit/index.js",
      "require": "./dist/audit/index.js",
      "types": "./dist/audit/index.d.ts"
    },
    "./history/conversation-title": {
      "import": "./dist/history/conversation-title.js",
      "require": "./dist/history/conversation-title.js",
      "types": "./dist/history/conversation-title.d.ts"
