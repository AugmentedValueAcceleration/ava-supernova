{
  "name": "@ava/core",
  "version": "0.2.59",
  "description": "Core engine for Ava Supernova — agent, providers, tools, config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./models": {
      "import": "./dist/providers/catalog.js",
      "require": "./dist/providers/catalog.js",
      "types": "./dist/providers/catalog.d.ts"
    },
    "./docs": {
      "import": "./dist/docs/index.js",
      "require": "./dist/docs/index.js",
      "types": "./dist/docs/index.d.ts"
    },
    "./desktop": {
      "import": "./dist/desktop/index.js",
      "require": "./dist/desktop/index.js",
      "types": "./dist/desktop/index.d.ts"
    },
    "./desktop-tools": {
      "import": "./dist/tools/desktop-tools.js",
      "require": "./dist/tools/desktop-tools.js",
      "types": "./dist/tools/desktop-tools.d.ts"
    },
    "./request-shaping": {
      "import": "./dist/providers/request-shaping/index.js",
      "require": "./dist/providers/request-shaping/index.js",
      "types": "./dist/providers/request-shaping/index.d.ts"
    },
    "./billing": {
      "import": "./dist/billing/plans.js",
      "require": "./dist/billing/plans.js",
      "types": "./dist/billing/plans.d.ts"
    },
    "./billing/credits": {
      "import": "./dist/billing/credits.js",
      "require": "./dist/billing/credits.js",
      "types": "./dist/billing/credits.d.ts"
    },
    "./creative": {
      "import": "./dist/creative/index.js",
