{
  "name": "ava-supernova",
  "displayName": "Ava | Supernova",
  "description": "%description%",
  "version": "0.4.3",
  "publisher": "augmentedvalueacceleration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AugmentedValueAcceleration/ava-supernova"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [],
  "icon": "media/AvaSupernovaIcon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ava-supernova",
          "title": "Ava | Supernova",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ava-supernova": [
        {
          "type": "webview",
          "id": "ava-supernova.chatView",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ava-supernova.openChat",
        "title": "%command.openChat.title%",
        "category": "Ava",
        "icon": {
          "light": "media/AvaSupernovaIcon.png",
          "dark": "media/AvaSupernovaIcon.png"
        }
      },
      {
        "command": "ava-supernova.newChat",
        "title": "%command.newChat.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.clearChat",
        "title": "%command.clearChat.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.switchModel",
        "title": "%command.switchModel.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.showHistory",
        "title": "%command.showHistory.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.gettingStarted",
        "title": "%command.gettingStarted.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDocs",
        "title": "%command.openDocs.title%",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Ava",
        "icon": "$(account)"
      }
    ],
    "walkthroughs": [
      {
        "id": "ava-supernova.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "addApiKey",
            "title": "%walkthrough.step.apiKey.title%",
            "description": "%walkthrough.step.apiKey.description%",
            "media": { "markdown": "media/walkthrough/api-key.md" },
            "completionEvents": ["onSettingChanged:ava-supernova.providers.deepseek.apiKey"]
          },
          {
            "id": "selectModel",
            "title": "%walkthrough.step.model.title%",
            "description": "%walkthrough.step.model.description%",
            "media": { "markdown": "media/walkthrough/select-model.md" },
            "completionEvents": ["onSettingChanged:ava-supernova.activeModel"]
          },
          {
            "id": "setLanguage",
            "title": "%walkthrough.step.language.title%",
            "description": "%walkthrough.step.language.description%",
            "media": { "markdown": "media/walkthrough/language.md" }
          },
          {
            "id": "permissions",
            "title": "%walkthrough.step.permissions.title%",
            "description": "%walkthrough.step.permissions.description%",
            "media": { "markdown": "media/walkthrough/permissions.md" }
          },
          {
            "id": "startChatting",
            "title": "%walkthrough.step.start.title%",
            "description": "%walkthrough.step.start.description%",
            "media": { "markdown": "media/walkthrough/start.md" },
            "completionEvents": ["onCommand:ava-supernova.openChat"]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%setting.section.modelApi%",
        "order": 1,
        "properties": {
          "ava-supernova.activeModel": {
            "type": "string",
            "default": "",
            "order": 1,
            "enum": [
              "",
              "deepseek:deepseek-chat",
              "deepseek:deepseek-reasoner",
              "kimi:kimi-k2.5",
              "kimi:moonshot-v1-128k",
              "zhipu:glm-5",
              "zhipu:glm-4.7",
              "zhipu:glm-4-flash",
              "mistral:mistral-large-latest",
              "mistral:codestral-latest",
              "mistral:devstral-2-25-12",
              "mistral:mistral-small-latest",
              "qwen:qwen3.5-plus",
              "qwen:qwen-turbo-latest",
              "anthropic:claude-opus-4-6",
              "anthropic:claude-sonnet-4-6",
              "anthropic:claude-haiku-4-5-20251001"
            ],
            "enumDescriptions": [
              "No model selected",
              "DeepSeek V3 — fast, affordable general-purpose",
              "DeepSeek R1 — reasoning model",
              "Kimi K2.5 — best multi-step tool calling",
              "Moonshot V1 128K — long context",
              "GLM-5 — best tool-call reliability, vision",
              "GLM-4.7 — fast, reliable general-purpose",
              "GLM-4 Flash — lightweight and fast",
              "Mistral Large 3 — strong European model",
              "Codestral — code-specialized, 256K context",
              "Devstral 2 — agentic coding model",
              "Mistral Small — fast and affordable",
              "Qwen 3.5 Plus — vision, thinking, 256K context",
              "Qwen Turbo — fast and cheap, 1M context",
              "Claude Opus 4.6 — most capable, vision, 200K context",
              "Claude Sonnet 4.6 — balanced speed and intelligence",
              "Claude Haiku 4.5 — fast and affordable"
            ],
            "description": "%setting.activeModel.description%"
          }
        }
      },
      {
        "title": "%setting.section.preferences%",
        "order": 2,
        "properties": {
          "ava-supernova.preferences.temperature": {
            "type": "number",
            "default": 0.7,
            "order": 1,
            "description": "%setting.temperature.description%"
          },
          "ava-supernova.preferences.language": {
            "type": "string",
            "default": "auto",
            "order": 2,
            "enum": [
              "auto", "en", "zh-CN", "zh-TW", "ja", "ko",
              "es", "pt", "fr", "de", "ru", "ar", "hi",
              "vi", "th", "tr", "it", "pl", "uk", "nl", "id"
            ],
            "enumItemLabels": [
              "%lang.auto%",
              "%lang.en%",
              "%lang.zh-CN%",
              "%lang.zh-TW%",
              "%lang.ja%",
              "%lang.ko%",
              "%lang.es%",
              "%lang.pt%",
              "%lang.fr%",
              "%lang.de%",
              "%lang.ru%",
              "%lang.ar%",
              "%lang.hi%",
              "%lang.vi%",
              "%lang.th%",
              "%lang.tr%",
              "%lang.it%",
              "%lang.pl%",
              "%lang.uk%",
              "%lang.nl%",
              "%lang.id%"
            ],
            "enumDescriptions": [
              "%lang.auto.desc%",
              "",
              "中文（简体）",
              "中文（繁體）",
              "日本語",
              "한국어",
              "Español",
              "Português",
              "Français",
              "Deutsch",
              "Русский",
              "العربية",
              "हिन्दी",
              "Tiếng Việt",
              "ไทย",
              "Türkçe",
              "Italiano",
              "Polski",
              "Українська",
              "Nederlands",
              "Bahasa Indonesia"
            ],
            "description": "%setting.language.description%"
          },
          "ava-supernova.preferences.permissionMode": {
            "type": "string",
            "default": "strict",
            "order": 3,
            "enum": ["strict", "balanced", "autonomous"],
            "enumDescriptions": [
              "Confirm all file writes and shell commands (safest)",
              "Auto-approve file edits, confirm shell commands only",
              "Auto-approve everything — full autonomy (use with caution)"
            ],
            "description": "%setting.permissionMode.description%"
          },
          "ava-supernova.preferences.maxTokens": {
            "type": "number",
            "default": 8192,
            "order": 4,
            "description": "%setting.maxTokens.description%"
          },
          "ava-supernova.preferences.autoMemory": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%setting.autoMemory.description%"
          },
          "ava-supernova.preferences.streamResponses": {
            "type": "boolean",
            "default": true,
            "order": 6,
            "description": "%setting.streamResponses.description%"
          }
        }
      },
      {
        "title": "%setting.section.help%",
        "order": 3,
        "properties": {
          "ava-supernova.help.documentation": {
            "type": "null",
            "order": 1,
            "markdownDescription": "%setting.help.docs%"
          },
          "ava-supernova.help.gettingStarted": {
            "type": "null",
            "order": 2,
            "markdownDescription": "%setting.help.gettingStarted%"
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ava-supernova.openChat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ava-supernova.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ]
  },
  "scripts": {
    "build:webview": "cd webview-ui && npx vite build",
    "build:dashboard": "cd dashboard-ui && npx vite build",
    "build:extension": "node esbuild.config.mjs",
    "build": "pnpm build:webview && pnpm build:dashboard && pnpm build:extension",
    "dev:webview": "cd webview-ui && npx vite build --watch",
    "dev:dashboard": "cd dashboard-ui && npx vite build --watch",
    "dev:extension": "node esbuild.config.mjs --watch",
    "package": "pnpm build && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ava/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^25.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
