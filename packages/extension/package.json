{
  "name": "ava-supernova",
  "displayName": "Ava | Supernova",
  "description": "%description%",
  "version": "0.18.7",
  "publisher": "augmentedvalueacceleration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AugmentedValueAcceleration/ava-supernova"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "deepseek",
    "kimi",
    "qwen",
    "mistral",
    "open source",
    "free",
    "copilot",
    "autocomplete",
    "llm",
    "code assistant",
    "agentic",
    "tools",
    "chat",
    "memory"
  ],
  "activationEvents": [],
  "icon": "media/AvaSupernovaIcon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ava-supernova",
          "title": "Ava | Supernova",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ava-supernova": [
        {
          "type": "webview",
          "id": "ava-supernova.chatView",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ava-supernova.openChat",
        "title": "%command.openChat.title%",
        "shortTitle": "Open Chat",
        "category": "Ava",
        "icon": {
          "light": "media/AvaSupernovaIcon.png",
          "dark": "media/AvaSupernovaIcon.png"
        }
      },
      {
        "command": "ava-supernova.newChat",
        "title": "%command.newChat.title%",
        "shortTitle": "New Chat",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.focusInput",
        "title": "Focus Chat Input",
        "shortTitle": "Focus Input",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.clearChat",
        "title": "%command.clearChat.title%",
        "shortTitle": "Clear",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.switchModel",
        "title": "%command.switchModel.title%",
        "shortTitle": "Switch Model",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.showHistory",
        "title": "%command.showHistory.title%",
        "shortTitle": "History",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDocs",
        "title": "%command.openDocs.title%",
        "shortTitle": "Docs",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDashboard",
        "title": "%command.openDashboard.title%",
        "shortTitle": "Dashboard",
        "category": "Ava",
        "icon": "$(account)"
      },
      {
        "command": "ava-supernova.previewDocument",
        "title": "Preview Document",
        "shortTitle": "Preview",
        "category": "Ava",
        "icon": "$(open-preview)"
      }
    ],
    "walkthroughs": [],
    "configuration": [
      {
        "title": "%setting.section.modelApi%",
        "order": 1,
        "properties": {
          "ava-supernova.activeModel": {
            "type": "string",
            "default": "",
            "order": 1,
            "enum": [
              "",
              "deepseek:deepseek-chat",
              "deepseek:deepseek-reasoner",
              "kimi:kimi-k2.5",
              "qwen:qwen3.5-plus",
              "zhipu:glm-5",
              "zhipu:glm-4.7-flash",
              "zhipu:glm-4.5-flash",
              "mistral:mistral-large-latest",
              "mistral:codestral-latest",
              "mistral:devstral-latest",
              "anthropic:claude-opus-4-6",
              "anthropic:claude-sonnet-4-6",
              "anthropic:claude-haiku-4-5-20251001"
            ],
            "enumDescriptions": [
              "No model selected — free models are always available",
              "DeepSeek V3.2 — best value at $0.28/M input, fast general-purpose coding",
              "DeepSeek Reasoner — chain-of-thought reasoning for complex problems",
              "Kimi K2.5 — 76.8% SWE-Bench, best tool calling, vision, 256K context",
              "Qwen 3.5 Plus — thinking + vision, 256K context, $0.40/M input",
              "GLM-5 — 77.8% SWE-Bench, vision, best tool-call reliability",
              "GLM-4.7 Flash — FREE, no API key needed, 30B MoE, 128K context, tool calling",
              "GLM-4.5 Flash — FREE, no API key needed, stable and reliable",
              "Mistral Large — vision, 262K context, strong European model",
              "Codestral — code-specialized, 256K context, optimised for development",
              "Devstral 2 — 262K context, built for agentic coding workflows",
              "Claude Opus 4.6 — frontier model, vision, 200K context, most capable",
              "Claude Sonnet 4.6 — balanced speed and intelligence, vision",
              "Claude Haiku 4.5 — fastest Anthropic model, affordable"
            ],
            "description": "%setting.activeModel.description%"
          }
        }
      },
      {
        "title": "%setting.section.preferences%",
        "order": 2,
        "properties": {
          "ava-supernova.preferences.temperature": {
            "type": "number",
            "default": 0.7,
            "order": 1,
            "description": "%setting.temperature.description%"
          },
          "ava-supernova.preferences.language": {
            "type": "string",
            "default": "auto",
            "order": 2,
            "enum": [
              "auto",
              "en",
              "zh-CN",
              "zh-TW",
              "ja",
              "ko",
              "es",
              "pt",
              "fr",
              "de",
              "ru",
              "ar",
              "hi",
              "vi",
              "th",
              "tr",
              "it",
              "pl",
              "uk",
              "nl",
              "id"
            ],
            "enumItemLabels": [
              "%lang.auto%",
              "%lang.en%",
              "%lang.zh-CN%",
              "%lang.zh-TW%",
              "%lang.ja%",
              "%lang.ko%",
              "%lang.es%",
              "%lang.pt%",
              "%lang.fr%",
              "%lang.de%",
              "%lang.ru%",
              "%lang.ar%",
              "%lang.hi%",
              "%lang.vi%",
              "%lang.th%",
              "%lang.tr%",
              "%lang.it%",
              "%lang.pl%",
              "%lang.uk%",
              "%lang.nl%",
              "%lang.id%"
            ],
            "enumDescriptions": [
              "%lang.auto.desc%",
              "",
              "中文（简体）",
              "中文（繁體）",
              "日本語",
              "한국어",
              "Español",
              "Português",
              "Français",
              "Deutsch",
              "Русский",
              "العربية",
              "हिन्दी",
              "Tiếng Việt",
              "ไทย",
              "Türkçe",
              "Italiano",
              "Polski",
              "Українська",
              "Nederlands",
              "Bahasa Indonesia"
            ],
            "description": "%setting.language.description%"
          },
          "ava-supernova.preferences.permissionMode": {
            "type": "string",
            "default": "strict",
            "order": 3,
            "enum": [
              "strict",
              "balanced",
              "autonomous"
            ],
            "enumDescriptions": [
              "Confirm all file writes and shell commands (safest)",
              "Auto-approve file edits, confirm shell commands only",
              "Auto-approve everything — full autonomy (use with caution)"
            ],
            "description": "%setting.permissionMode.description%"
          },
          "ava-supernova.preferences.maxTokens": {
            "type": "number",
            "default": 8192,
            "order": 4,
            "description": "%setting.maxTokens.description%"
          },
          "ava-supernova.preferences.autoMemory": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%setting.autoMemory.description%"
          },
          "ava-supernova.preferences.memoryLocalOnly": {
            "type": "boolean",
            "default": false,
            "order": 6,
            "description": "%setting.memoryLocalOnly.description%"
          },
          "ava-supernova.preferences.streamResponses": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "%setting.streamResponses.description%"
          }
        }
      },
      {
        "title": "%setting.section.help%",
        "order": 3,
        "properties": {
          "ava-supernova.help.documentation": {
            "type": "null",
            "order": 1,
            "markdownDescription": "%setting.help.docs%"
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ava-supernova.openChat",
          "group": "navigation"
        },
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|pdf)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|pdf)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ava-supernova.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "ava-supernova.focusInput",
        "key": "ctrl+escape",
        "mac": "ctrl+escape"
      }
    ]
  },
  "scripts": {
    "build:webview": "cd webview-ui && npx vite build",
    "build:dashboard": "cd dashboard-ui && npx vite build",
    "build:extension": "node esbuild.config.mjs",
    "build": "pnpm build:webview && pnpm build:dashboard && pnpm build:extension",
    "dev:webview": "cd webview-ui && npx vite build --watch",
    "dev:dashboard": "cd dashboard-ui && npx vite build --watch",
    "dev:extension": "node esbuild.config.mjs --watch",
    "package": "pnpm build && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ava/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
