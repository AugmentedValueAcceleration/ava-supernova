{
  "name": "ava-supernova",
  "displayName": "Ava | Supernova",
  "description": "Open-source AI coding agent — DeepSeek, Kimi, GLM, and Mistral in your editor",
  "version": "0.1.0",
  "publisher": "stewai",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "icon": "media/AvaSupernovaIcon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ava-supernova",
          "title": "Ava | Supernova",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ava-supernova": [
        {
          "type": "webview",
          "id": "ava-supernova.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ava-supernova.openChat",
        "title": "Open Chat",
        "category": "Ava",
        "icon": {
          "light": "media/AvaSupernovaIcon.png",
          "dark": "media/AvaSupernovaIcon.png"
        }
      },
      {
        "command": "ava-supernova.newChat",
        "title": "New Chat",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.clearChat",
        "title": "Clear Chat",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.switchModel",
        "title": "Switch Model",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.showHistory",
        "title": "Chat History",
        "category": "Ava"
      }
    ],
    "configuration": {
      "title": "Ava | Supernova",
      "properties": {
        "ava-supernova.activeModel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "deepseek:deepseek-chat",
            "deepseek:deepseek-reasoner",
            "kimi:kimi-k2.5",
            "kimi:moonshot-v1-128k",
            "zhipu:glm-5",
            "zhipu:glm-4.7",
            "zhipu:glm-4-flash",
            "mistral:mistral-large-latest",
            "mistral:codestral-latest",
            "mistral:mistral-small-latest"
          ],
          "enumDescriptions": [
            "No model selected",
            "DeepSeek V3 — fast, affordable general-purpose",
            "DeepSeek R1 — reasoning model",
            "Kimi K2.5 — best multi-step tool calling",
            "Moonshot V1 128K — long context",
            "GLM-5 — best tool-call reliability",
            "GLM-4.7 — balanced performance",
            "GLM-4 Flash — fast and lightweight",
            "Mistral Large — strongest Mistral model",
            "Codestral — optimized for code",
            "Mistral Small — fast and efficient"
          ],
          "description": "Select the AI model to use"
        },
        "ava-supernova.providers.deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key"
        },
        "ava-supernova.providers.kimi.apiKey": {
          "type": "string",
          "default": "",
          "description": "Kimi (Moonshot AI) API key"
        },
        "ava-supernova.providers.zhipu.apiKey": {
          "type": "string",
          "default": "",
          "description": "Zhipu AI (GLM) API key"
        },
        "ava-supernova.providers.mistral.apiKey": {
          "type": "string",
          "default": "",
          "description": "Mistral AI API key"
        },
        "ava-supernova.preferences.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "Sampling temperature"
        },
        "ava-supernova.preferences.permissionMode": {
          "type": "string",
          "default": "strict",
          "enum": ["strict", "balanced", "autonomous"],
          "enumDescriptions": [
            "Confirm all file writes and shell commands (safest)",
            "Auto-approve file edits, confirm shell commands only",
            "Auto-approve everything — full autonomy (use with caution)"
          ],
          "description": "Controls which tool operations require your approval before Ava executes them"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "ava-supernova.openChat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ava-supernova.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ]
  },
  "scripts": {
    "build:webview": "cd webview-ui && npx vite build",
    "build:extension": "node esbuild.config.mjs",
    "build": "pnpm build:webview && pnpm build:extension",
    "dev:webview": "cd webview-ui && npx vite build --watch",
    "dev:extension": "node esbuild.config.mjs --watch",
    "package": "pnpm build && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ava/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^25.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
