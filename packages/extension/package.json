{
  "name": "ava-supernova",
  "displayName": "Ava Supernova",
  "description": "%description%",
  "version": "0.121.0",
  "publisher": "augmentedvalueacceleration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AugmentedValueAcceleration/ava-supernova"
  },
  "homepage": "https://avasupernova.com",
  "privacy": "https://avasupernova.com/privacy",
  "pricing": "Free",
  "qna": "https://github.com/AugmentedValueAcceleration/ava-supernova/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "deepseek",
    "kimi",
    "qwen",
    "mistral",
    "open source",
    "free",
    "copilot",
    "autocomplete",
    "llm",
    "code assistant",
    "agentic",
    "tools",
    "chat",
    "memory"
  ],
  "activationEvents": [
    "onUri",
    "onWebviewPanel:ava-supernova.dashboard"
  ],
  "icon": "media/AvaSupernovaIcon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ava-supernova",
          "title": "Ava Supernova",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ava-supernova": [
        {
          "type": "webview",
          "id": "ava-supernova.chatView",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ava-supernova.openChat",
        "title": "%command.openChat.title%",
        "shortTitle": "Open Chat",
        "category": "Ava",
        "icon": {
          "light": "media/AvaSupernovaIcon.png",
          "dark": "media/AvaSupernovaIcon.png"
        }
      },
      {
        "command": "ava-supernova.newChat",
        "title": "%command.newChat.title%",
        "shortTitle": "New Chat",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.focusInput",
        "title": "Focus Chat Input",
        "shortTitle": "Focus Input",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.clearChat",
        "title": "%command.clearChat.title%",
        "shortTitle": "Clear",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.switchModel",
        "title": "%command.switchModel.title%",
        "shortTitle": "Switch Model",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.showHistory",
        "title": "%command.showHistory.title%",
        "shortTitle": "History",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openWelcome",
        "title": "Show Welcome Tour",
        "shortTitle": "Welcome",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDocs",
        "title": "%command.openDocs.title%",
        "shortTitle": "Docs",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDashboard",
        "title": "%command.openDashboard.title%",
        "shortTitle": "Dashboard",
        "category": "Ava",
        "icon": "$(account)"
      },
      {
        "command": "ava-supernova.previewDocument",
        "title": "Preview Document",
        "shortTitle": "Preview",
        "category": "Ava",
        "icon": "$(open-preview)"
      }
    ],
    "walkthroughs": [
      {
        "id": "ava-supernova.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "apiKey",
            "title": "%walkthrough.step.apiKey.title%",
            "description": "%walkthrough.step.apiKey.description%",
            "media": {
              "markdown": "media/walkthrough/api-key.md"
            },
            "completionEvents": [
              "onCommand:ava-supernova.openChat"
            ]
          },
          {
            "id": "model",
            "title": "%walkthrough.step.model.title%",
            "description": "%walkthrough.step.model.description%",
            "media": {
              "markdown": "media/walkthrough/select-model.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.activeModel"
            ]
          },
          {
            "id": "language",
            "title": "%walkthrough.step.language.title%",
            "description": "%walkthrough.step.language.description%",
            "media": {
              "markdown": "media/walkthrough/language.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.preferences.language"
            ]
          },
          {
            "id": "permissions",
            "title": "%walkthrough.step.permissions.title%",
            "description": "%walkthrough.step.permissions.description%",
            "media": {
              "markdown": "media/walkthrough/permissions.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.preferences.permissionMode"
            ]
          },
          {
            "id": "start",
            "title": "%walkthrough.step.start.title%",
            "description": "%walkthrough.step.start.description%",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onCommand:ava-supernova.openChat"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%setting.section.modelApi%",
        "order": 1,
        "properties": {
          "ava-supernova.activeModel": {
            "type": "string",
            "default": "",
            "order": 1,
            "enum": [
              "",
              "deepseek:deepseek-flash",
              "kimi:kimi-k3.1-pro",
              "kimi:kimi-k3.1-pro-highspeed",
              "kimi:kimi-k3",
              "qwen:qwen3.8-flash",
              "qwen:qwen3.7-flash",
              "qwen:qwen3.7-plus",
              "qwen:qwen4-max",
              "qwen:qwen3-coder-next",
              "qwen:qwen3-coder-flash",
              "zhipu:glm-5.3",
              "zhipu:glm-5.3-flash",
              "minimax:MiniMax-M3",
              "minimax:MiniMax-M3.1-Flash",
              "xiaomi:mimo-v2.6-pro",
              "xiaomi:mimo-v2.6-flash",
              "xiaomi:mimo-v2.6-pro-ultraspeed",
              "mistral:mistral-large-4",
              "mistral:mistral-small-4",
              "tencent:hy4",
              "tencent:hy4-flash",
              "nvidia:nvidia/nemotron-3-ultra-550b-a55b",
              "nvidia:nvidia/nemotron-3.5-lightning-30b-a3b"
            ],
            "enumDescriptions": [
              "No model selected — add a provider key, or point Ava at a local model",
              "DeepSeek V4.1 Flash — 1M context, multimodal, 384K output, MIT open-weight ($0.15/$0.60 off-peak)",
              "Kimi K3.1 Pro — Moonshot's flagship, a post-trained K3, 1M context, native vision ($2/$10)",
              "Kimi K3.1 Pro Highspeed — the same model 2-3x faster, at double the price",
              "Kimi K3 — Moonshot's previous flagship, 2.8T MoE, 1M context, native vision",
              "Qwen 3.8 Flash — Qwen4-architecture preview, 1M context, image + video, beats 3.7 Plus on agentic coding at a third the price",
              "Qwen 3.7 Flash — 1M context, vision, tiered pricing; reasons by default so short answers cost more than the headline rate",
              "Qwen 3.7 Plus — flagship Qwen, agentic coding, 1M context, vision",
              "Qwen 4 Max — Alibaba's flagship, 1M context, image + video, thinking",
              "Qwen3 Coder Next — coding specialist, 256K context, text only, very cheap",
              "Qwen3 Coder Flash — coding specialist, 1M context, text only",
              "GLM-5.3 — MIT open-weight, 1M context, thinking (text only)",
              "GLM-5.3 Flash — BYOK, 1M context, reads images and video",
              "MiniMax M3 — flagship, 1M context, native multimodal (BYOK)",
              "MiniMax M3.1 Flash — open-weight everyday model, 1M context, tunable thinking, text only (BYOK)",
              "MiMo V2.6-Pro — Xiaomi, MIT open weights, 1M context, full modality, long-horizon agents (BYOK)",
              "MiMo V2.6-Flash — the same family at a third of the price, 1M context (BYOK)",
              "MiMo V2.6-Pro UltraSpeed — the same Pro served up to 20x faster, ten times the price (BYOK)",
              "Mistral Large 4 — Mistral's flagship, open-weight, 1M context, reasoning + vision — Aurora's lead",
              "Mistral Small 4 — agentic + vision unified, 262K, $0.15/$0.60 — Aurora workhorse",
              "Hunyuan Hy4 — Tencent's flagship, 1M context, vision, reasoning (BYOK)",
              "Hunyuan Hy4 Flash — fast and very cheap, 1M context, vision (BYOK)",
              "Nemotron 3 Ultra — NVIDIA open-weight, 1M context, frontier reasoning (BYOK)",
              "Nemotron 3.5 Lightning — NVIDIA's small open model, fully open data, 1M context, very cheap (BYOK)"
            ],
            "description": "%setting.activeModel.description%"
          }
        }
      },
      {
        "title": "%setting.section.preferences%",
        "order": 2,
        "properties": {
          "ava-supernova.preferences.temperature": {
            "type": "number",
            "default": 0.7,
            "order": 1,
            "description": "%setting.temperature.description%"
          },
          "ava-supernova.preferences.language": {
            "type": "string",
            "default": "auto",
            "order": 2,
            "enum": [
              "auto",
              "en",
              "zh-CN",
              "zh-TW",
              "ja",
              "ko",
              "es",
              "pt",
              "fr",
              "de",
              "ru",
              "ar",
              "hi",
              "vi",
              "th",
              "tr",
              "it",
              "pl",
              "uk",
              "nl",
              "id"
            ],
            "enumItemLabels": [
              "%lang.auto%",
              "%lang.en%",
              "%lang.zh-CN%",
              "%lang.zh-TW%",
              "%lang.ja%",
              "%lang.ko%",
              "%lang.es%",
              "%lang.pt%",
              "%lang.fr%",
              "%lang.de%",
              "%lang.ru%",
              "%lang.ar%",
              "%lang.hi%",
              "%lang.vi%",
              "%lang.th%",
              "%lang.tr%",
              "%lang.it%",
              "%lang.pl%",
              "%lang.uk%",
              "%lang.nl%",
              "%lang.id%"
            ],
            "enumDescriptions": [
              "%lang.auto.desc%",
              "",
              "中文（简体）",
              "中文（繁體）",
              "日本語",
              "한국어",
              "Español",
              "Português",
              "Français",
              "Deutsch",
              "Русский",
              "العربية",
              "हिन्दी",
              "Tiếng Việt",
              "ไทย",
              "Türkçe",
              "Italiano",
              "Polski",
              "Українська",
              "Nederlands",
              "Bahasa Indonesia"
            ],
            "description": "%setting.language.description%"
          },
          "ava-supernova.preferences.permissionMode": {
            "type": "string",
            "default": "strict",
            "order": 3,
            "enum": [
              "strict",
              "balanced",
              "autonomous"
            ],
            "enumDescriptions": [
              "Confirm all file writes and shell commands (safest)",
              "Auto-approve file edits, confirm shell commands only",
              "Auto-approve everything — full autonomy (use with caution)"
            ],
            "description": "%setting.permissionMode.description%"
          },
          "ava-supernova.preferences.maxTokens": {
            "type": "number",
            "default": 8192,
            "order": 4,
            "description": "%setting.maxTokens.description%"
          },
          "ava-supernova.preferences.autoMemory": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%setting.autoMemory.description%"
          },
          "ava-supernova.preferences.showWelcomeOnStartup": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "Show the Ava welcome tour each time the panel opens. Turn off to hide it; you can re-enable it here or replay it any time with the 'Ava: Show Welcome Tour' command."
          },
          "ava-supernova.preferences.taskReminders": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "Show a notification when a task with a reminder falls due. Reminders fire while VS Code is open, even if the Tasks panel is closed. Turn off to silence all task reminders."
          },
          "ava-supernova.preferences.useLocalEmbeddings": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "description": "Semantic memory recall via a local embedding model. Off = keyword recall only (no dependency). Requires Ollama running with an embedding model (e.g. nomic-embed-text)."
          },
          "ava-supernova.preferences.embeddingModel": {
            "type": "string",
            "default": "nomic-embed-text",
            "order": 9,
            "description": "Local embedding model (served by Ollama) used when semantic recall is enabled."
          },
          "ava-supernova.preferences.projectsHome": {
            "type": "string",
            "default": "",
            "order": 11,
            "markdownDescription": "Folder where Ava creates new projects. Leave empty for `~/Ava Projects`. Deliberately not inside `~/.ava` — that is hidden application data, and source code kept in a dotfolder gets lost and gets skipped by backup tools."
          },
          "ava-supernova.preferences.embeddingBaseUrl": {
            "type": "string",
            "default": "http://localhost:11434/v1",
            "order": 10,
            "description": "OpenAI-compatible embeddings base URL. Default: local Ollama."
          },
          "ava-supernova.preferences.streamResponses": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "%setting.streamResponses.description%"
          },
          "ava-supernova.contributeSharedLearning": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "markdownDescription": "Help improve Ava for everyone. When enabled, anonymised feedback data (ratings, model and mode used — no code, no conversation content) is shared to improve response quality. **Off by default.** See [Privacy Policy](https://avasupernova.com/privacy) for details."
          },
          "ava-supernova.loopPrevention.enabled": {
            "type": "boolean",
            "default": true,
            "order": 9,
            "markdownDescription": "When Ava is about to declare a turn done with file edits that haven't been verified, run typecheck/tests against those files first. On failure, she gets one chance to fix before closing. If the same failure recurs three times in a row, an independent fresh-eyes review fires (one extra LLM call, surfaced as a `loop guard fired` event). **On by default** — catches build-broken closures and stops stuck loops from burning credits. Disable only if you prefer faster turn-end and accept that broken edits may ship without notice."
          }
        }
      },
      {
        "title": "%setting.section.help%",
        "order": 3,
        "properties": {
          "ava-supernova.help.documentation": {
            "type": "null",
            "order": 1,
            "markdownDescription": "%setting.help.docs%"
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ava-supernova.openChat",
          "group": "navigation"
        },
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|ods|pdf)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|ods|pdf)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ava-supernova.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "ava-supernova.focusInput",
        "key": "ctrl+escape",
        "mac": "ctrl+escape"
      }
    ]
  },
  "scripts": {
    "build:webview": "cd webview-ui && npx vite build",
    "build:dashboard": "cd dashboard-ui && npx vite build",
    "build:extension": "node esbuild.config.mjs",
    "build:locales": "node scripts/emit-locales.mjs",
    "build": "pnpm build:locales && pnpm build:webview && pnpm build:dashboard && pnpm build:extension",
    "dev:webview": "cd webview-ui && npx vite build --watch",
    "dev:dashboard": "cd dashboard-ui && npx vite build --watch",
    "dev:extension": "node esbuild.config.mjs --watch",
    "package": "node ../../scripts/i18n-check.mjs && pnpm build && node scripts/check-documents.mjs && npx @vscode/vsce package --no-dependencies && node scripts/prune-vsix.mjs",
    "check:documents": "node scripts/check-documents.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:webviews": "cd dashboard-ui && tsc --noEmit && cd ../webview-ui && tsc --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:webviews",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ava/core": "workspace:*",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "galleryBanner": {
    "color": "#1a1028",
    "theme": "dark"
  }
}
