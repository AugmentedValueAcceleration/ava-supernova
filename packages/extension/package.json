{
  "name": "ava-supernova",
  "displayName": "Ava Supernova",
  "description": "%description%",
  "version": "0.88.0",
  "publisher": "augmentedvalueacceleration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AugmentedValueAcceleration/ava-supernova"
  },
  "homepage": "https://ava-supernova.com",
  "privacy": "https://ava-supernova.com/privacy",
  "pricing": "Free",
  "qna": "https://github.com/AugmentedValueAcceleration/ava-supernova/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "deepseek",
    "kimi",
    "qwen",
    "mistral",
    "open source",
    "free",
    "copilot",
    "autocomplete",
    "llm",
    "code assistant",
    "agentic",
    "tools",
    "chat",
    "memory"
  ],
  "activationEvents": [
    "onUri"
  ],
  "icon": "media/AvaSupernovaIcon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ava-supernova",
          "title": "Ava Supernova",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ava-supernova": [
        {
          "type": "webview",
          "id": "ava-supernova.chatView",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ava-supernova.openChat",
        "title": "%command.openChat.title%",
        "shortTitle": "Open Chat",
        "category": "Ava",
        "icon": {
          "light": "media/AvaSupernovaIcon.png",
          "dark": "media/AvaSupernovaIcon.png"
        }
      },
      {
        "command": "ava-supernova.newChat",
        "title": "%command.newChat.title%",
        "shortTitle": "New Chat",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.focusInput",
        "title": "Focus Chat Input",
        "shortTitle": "Focus Input",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.clearChat",
        "title": "%command.clearChat.title%",
        "shortTitle": "Clear",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.switchModel",
        "title": "%command.switchModel.title%",
        "shortTitle": "Switch Model",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.showHistory",
        "title": "%command.showHistory.title%",
        "shortTitle": "History",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openWelcome",
        "title": "Show Welcome Tour",
        "shortTitle": "Welcome",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDocs",
        "title": "%command.openDocs.title%",
        "shortTitle": "Docs",
        "category": "Ava"
      },
      {
        "command": "ava-supernova.openDashboard",
        "title": "%command.openDashboard.title%",
        "shortTitle": "Dashboard",
        "category": "Ava",
        "icon": "$(account)"
      },
      {
        "command": "ava-supernova.previewDocument",
        "title": "Preview Document",
        "shortTitle": "Preview",
        "category": "Ava",
        "icon": "$(open-preview)"
      }
    ],
    "walkthroughs": [
      {
        "id": "ava-supernova.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "apiKey",
            "title": "%walkthrough.step.apiKey.title%",
            "description": "%walkthrough.step.apiKey.description%",
            "media": {
              "markdown": "media/walkthrough/api-key.md"
            },
            "completionEvents": [
              "onCommand:ava-supernova.openChat"
            ]
          },
          {
            "id": "model",
            "title": "%walkthrough.step.model.title%",
            "description": "%walkthrough.step.model.description%",
            "media": {
              "markdown": "media/walkthrough/select-model.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.activeModel"
            ]
          },
          {
            "id": "language",
            "title": "%walkthrough.step.language.title%",
            "description": "%walkthrough.step.language.description%",
            "media": {
              "markdown": "media/walkthrough/language.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.preferences.language"
            ]
          },
          {
            "id": "permissions",
            "title": "%walkthrough.step.permissions.title%",
            "description": "%walkthrough.step.permissions.description%",
            "media": {
              "markdown": "media/walkthrough/permissions.md"
            },
            "completionEvents": [
              "onSettingChanged:ava-supernova.preferences.permissionMode"
            ]
          },
          {
            "id": "start",
            "title": "%walkthrough.step.start.title%",
            "description": "%walkthrough.step.start.description%",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onCommand:ava-supernova.openChat"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%setting.section.modelApi%",
        "order": 1,
        "properties": {
          "ava-supernova.activeModel": {
            "type": "string",
            "default": "",
            "order": 1,
            "enum": [
              "",
              "deepseek:deepseek-v4-pro",
              "deepseek:deepseek-v4-flash",
              "kimi:kimi-k3",
              "kimi:kimi-k2.7-code",
              "qwen:qwen3.7-plus",
              "qwen:qwen3.7-max",
              "qwen:qwen3.5-plus",
              "qwen:qwen3.5-flash",
              "zhipu:glm-5.2",
              "zhipu:glm-4.5-air",
              "minimax:MiniMax-M3",
              "minimax:MiniMax-M2.7",
              "minimax:MiniMax-M2.7-highspeed",
              "xiaomi:mimo-v2.5-pro",
              "xiaomi:mimo-v2.5",
              "mistral:mistral-large-3",
              "mistral:mistral-medium-3.5",
              "mistral:mistral-small-4",
              "mistral:codestral-latest",
              "mistral:devstral-latest",
              "anthropic:claude-fable-5",
              "anthropic:claude-opus-4-8",
              "anthropic:claude-sonnet-5",
              "anthropic:claude-haiku-4-5-20251001",
              "tencent:hy3-preview",
              "nvidia:nvidia/nemotron-3-ultra-550b-a55b"
            ],
            "enumDescriptions": [
              "No model selected — sign in for 300 free credits/month, or bring your own keys",
              "DeepSeek V4 Pro — frontier reasoning, 1M context, MIT open-weight",
              "DeepSeek V4 Flash — best value at $0.14/$0.28 per M, fast long-context coding",
              "Kimi K3 — Moonshot frontier model, 2.8T MoE, 1M context, native vision",
              "Kimi K2.7 Code — agentic coding leader, 256K context, multimodal",
              "Qwen 3.7 Plus — flagship Qwen, agentic coding, 1M context, vision",
              "Qwen 3.7 Max — Alibaba's heavy flagship, 1M context, vision",
              "Qwen 3.5 Plus — thinking + vision, 1M context",
              "Qwen 3.5 Flash — fast and cheap, free-tier default",
              "GLM-5.2 — MIT open-weight, 1M context, vision + thinking",
              "GLM-4.5 Air — BYOK, lightweight, 128K context, tool calling",
              "MiniMax M3 — flagship, 1M context, native multimodal (BYOK)",
              "MiniMax M2.7 — standard text tier, 205K context, no vision (BYOK)",
              "MiniMax M2.7 Highspeed — same model served fast, 205K context, no vision (BYOK)",
              "MiMo V2.5-Pro — Xiaomi, 1M context, long-running agents (BYOK)",
              "MiMo V2.5 — Xiaomi, 1M context, multimodal (BYOK)",
              "Mistral Large 3 — sparse MoE 41B/675B, frontier reasoning, 262K, Aurora reserve",
              "Mistral Medium 3.5 — EU frontier flagship, 128B dense, 256K, vision, 77.6% SWE-Bench Verified",
              "Mistral Small 4 — agentic + vision unified, 262K, $0.15/$0.60 — Aurora workhorse",
              "Codestral — code-specialized, 256K context, optimised for development",
              "Devstral 2 — 262K context, built for agentic coding workflows",
              "Claude Fable 5 — Anthropic's Mythos-class flagship, 1M context, vision (premium — $10/$50 per M)",
              "Claude Opus 4.8 — current Anthropic flagship, strongest reasoning, vision, 200K context",
              "Claude Sonnet 5 — balanced speed and intelligence, vision",
              "Claude Haiku 4.5 — fastest Anthropic model, affordable",
              "Hunyuan Hy3 — Tencent open-weight MoE, agentic, 262K, very cheap (BYOK)",
              "Nemotron 3 Ultra — NVIDIA open-weight, 1M context, frontier reasoning (BYOK)"
            ],
            "description": "%setting.activeModel.description%"
          }
        }
      },
      {
        "title": "%setting.section.preferences%",
        "order": 2,
        "properties": {
          "ava-supernova.preferences.temperature": {
            "type": "number",
            "default": 0.7,
            "order": 1,
            "description": "%setting.temperature.description%"
          },
          "ava-supernova.preferences.language": {
            "type": "string",
            "default": "auto",
            "order": 2,
            "enum": [
              "auto",
              "en",
              "zh-CN",
              "zh-TW",
              "ja",
              "ko",
              "es",
              "pt",
              "fr",
              "de",
              "ru",
              "ar",
              "hi",
              "vi",
              "th",
              "tr",
              "it",
              "pl",
              "uk",
              "nl",
              "id"
            ],
            "enumItemLabels": [
              "%lang.auto%",
              "%lang.en%",
              "%lang.zh-CN%",
              "%lang.zh-TW%",
              "%lang.ja%",
              "%lang.ko%",
              "%lang.es%",
              "%lang.pt%",
              "%lang.fr%",
              "%lang.de%",
              "%lang.ru%",
              "%lang.ar%",
              "%lang.hi%",
              "%lang.vi%",
              "%lang.th%",
              "%lang.tr%",
              "%lang.it%",
              "%lang.pl%",
              "%lang.uk%",
              "%lang.nl%",
              "%lang.id%"
            ],
            "enumDescriptions": [
              "%lang.auto.desc%",
              "",
              "中文（简体）",
              "中文（繁體）",
              "日本語",
              "한국어",
              "Español",
              "Português",
              "Français",
              "Deutsch",
              "Русский",
              "العربية",
              "हिन्दी",
              "Tiếng Việt",
              "ไทย",
              "Türkçe",
              "Italiano",
              "Polski",
              "Українська",
              "Nederlands",
              "Bahasa Indonesia"
            ],
            "description": "%setting.language.description%"
          },
          "ava-supernova.preferences.permissionMode": {
            "type": "string",
            "default": "strict",
            "order": 3,
            "enum": [
              "strict",
              "balanced",
              "autonomous"
            ],
            "enumDescriptions": [
              "Confirm all file writes and shell commands (safest)",
              "Auto-approve file edits, confirm shell commands only",
              "Auto-approve everything — full autonomy (use with caution)"
            ],
            "description": "%setting.permissionMode.description%"
          },
          "ava-supernova.preferences.maxTokens": {
            "type": "number",
            "default": 8192,
            "order": 4,
            "description": "%setting.maxTokens.description%"
          },
          "ava-supernova.preferences.autoMemory": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%setting.autoMemory.description%"
          },
          "ava-supernova.preferences.showWelcomeOnStartup": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "Show the Ava welcome tour each time the panel opens. Turn off to hide it; you can re-enable it here or replay it any time with the 'Ava: Show Welcome Tour' command."
          },
          "ava-supernova.preferences.memoryLocalOnly": {
            "type": "boolean",
            "default": false,
            "order": 6,
            "description": "%setting.memoryLocalOnly.description%"
          },
          "ava-supernova.preferences.taskReminders": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "Show a notification when a task with a reminder falls due. Reminders fire while VS Code is open, even if the Tasks panel is closed. Turn off to silence all task reminders."
          },
          "ava-supernova.preferences.useLocalEmbeddings": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "description": "Semantic memory recall via a local embedding model. Off = keyword recall only (no dependency). Requires Ollama running with an embedding model (e.g. nomic-embed-text)."
          },
          "ava-supernova.preferences.embeddingModel": {
            "type": "string",
            "default": "nomic-embed-text",
            "order": 9,
            "description": "Local embedding model (served by Ollama) used when semantic recall is enabled."
          },
          "ava-supernova.preferences.embeddingBaseUrl": {
            "type": "string",
            "default": "http://localhost:11434/v1",
            "order": 10,
            "description": "OpenAI-compatible embeddings base URL. Default: local Ollama."
          },
          "ava-supernova.preferences.streamResponses": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "%setting.streamResponses.description%"
          },
          "ava-supernova.contributeSharedLearning": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "markdownDescription": "Help improve Ava for everyone. When enabled, anonymised feedback data (ratings, model and mode used — no code, no conversation content) is shared to improve response quality. **Off by default.** See [Privacy Policy](https://ava-supernova.com/privacy) for details."
          },
          "ava-supernova.loopPrevention.enabled": {
            "type": "boolean",
            "default": true,
            "order": 9,
            "markdownDescription": "When Ava is about to declare a turn done with file edits that haven't been verified, run typecheck/tests against those files first. On failure, she gets one chance to fix before closing. If the same failure recurs three times in a row, an independent fresh-eyes review fires (one extra LLM call, surfaced as a `loop guard fired` event). **On by default** — catches build-broken closures and stops stuck loops from burning credits. Disable only if you prefer faster turn-end and accept that broken edits may ship without notice."
          }
        }
      },
      {
        "title": "%setting.section.help%",
        "order": 3,
        "properties": {
          "ava-supernova.help.documentation": {
            "type": "null",
            "order": 1,
            "markdownDescription": "%setting.help.docs%"
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ava-supernova.openChat",
          "group": "navigation"
        },
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|pdf)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ava-supernova.previewDocument",
          "when": "resourceExtname =~ /\\.(md|txt|csv|html|docx|xlsx|pdf)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ava-supernova.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "ava-supernova.focusInput",
        "key": "ctrl+escape",
        "mac": "ctrl+escape"
      }
    ]
  },
  "scripts": {
    "build:webview": "cd webview-ui && npx vite build",
    "build:dashboard": "cd dashboard-ui && npx vite build",
    "build:extension": "node esbuild.config.mjs",
    "build": "pnpm build:webview && pnpm build:dashboard && pnpm build:extension",
    "dev:webview": "cd webview-ui && npx vite build --watch",
    "dev:dashboard": "cd dashboard-ui && npx vite build --watch",
    "dev:extension": "node esbuild.config.mjs --watch",
    "package": "pnpm build && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:webviews": "cd dashboard-ui && tsc --noEmit && cd ../webview-ui && tsc --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:webviews",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ava/core": "workspace:*",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
